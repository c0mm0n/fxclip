    <string name="tour_1_title">Welcome to fxclip</string>
    <string name="tour_1_body">fxclip removes the tracking parameters added to the links you share: utm_*, fbclid, YouTube\'s si, Amazon referrals, and more. Nothing leaves your phone.</string>
    <string name="tour_2_title">Share a link</string>
    <string name="tour_2_body">In any app, tap Share and pick “Clean link”. fxclip offers the apps you share to most often, or the full share sheet. Telegram receives the preview version, so the post shows in full.</string>
    <string name="tour_3_title">Select a link</string>
    <string name="tour_3_body">Select a link in any text field and pick “Clean link” in the menu that appears. It is replaced on the spot. Android often hides these entries behind the three dots.</string>
    <string name="tour_4_title">Already copied?</string>
    <string name="tour_4_body">Add the quick-settings tile or the home-screen widget: one tap cleans the link on the clipboard. Opening fxclip does it too.</string>
