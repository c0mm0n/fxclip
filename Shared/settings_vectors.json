{
  "about": "User settings layered over rules.json. Each group's settings is a (possibly partial) settings.json; missing keys take their defaults. output = preview(clean(input).text, app) when app is set, else clean(input).text. Every port must pass these.",
  "groups": [
    {
      "name": "defaults",
      "settings": {},
      "cases": [
        {
          "input": "https://x.com/a?s=1&utm_source=b",
          "app": null,
          "output": "https://x.com/a"
        },
        {
          "input": "https://x.com/a?s=1&utm_source=b",
          "app": "ru.keepcoder.Telegram",
          "output": "https://fxtwitter.com/a"
        },
        {
          "input": "https://x.com/a",
          "app": "Telegram.exe",
          "output": "https://fxtwitter.com/a"
        },
        {
          "input": "https://x.com/a",
          "app": "telegram.EXE",
          "output": "https://fxtwitter.com/a"
        },
        {
          "input": "https://x.com/a",
          "app": "TelegramDesktop",
          "output": "https://fxtwitter.com/a"
        },
        {
          "input": "https://instagram.com/p/a",
          "app": "org.telegram.desktop",
          "output": "https://zzinstagram.com/p/a"
        },
        {
          "input": "https://x.com/a",
          "app": "firefox",
          "output": "https://x.com/a"
        },
        {
          "input": "https://x.com/a",
          "app": "ru.keepcoder.telegram",
          "output": "https://x.com/a"
        }
      ]
